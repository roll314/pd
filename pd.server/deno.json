{
  "tasks": {
    "dev": "deno run -A --watch main.ts",
    "build_nx": "deno compile -A --env-file --output ./dist/pd.server --target=x86_64-unknown-linux-gnu main.ts ",
    "build_win": "deno compile -A --env-file --output ./dist/pd.server.exe --target=x86_64-pc-windows-msvc main.ts ",
    "create_migrations": "deno --env -A --env-file --node-modules-dir npm:drizzle-kit generate",
    "migrate": "deno --env -A --env-file --node-modules-dir npm:drizzle-kit migrate",
    "push": "deno --env -A --env-file --node-modules-dir npm:drizzle-kit push"
  },
  "imports": {
    "@oak/oak": "jsr:@oak/oak@17.1.4",
    "@std/assert": "jsr:@std/assert@1.0.13",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.5",
    "@std/path": "jsr:@std/path@1.1.0",
    "@std/http": "jsr:@std/http@1.1.0",
    "dotenv": "jsr:@std/dotenv@0.225.5",
    "@types/pg": "npm:@types/pg@~8.15.4",
    "drizzle-kit": "npm:drizzle-kit@~0.31.4",
    "drizzle-orm": "npm:drizzle-orm@~0.44.2",
    "pg": "npm:pg@~8.16.3"
  }
}
